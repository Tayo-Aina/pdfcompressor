<!-- =========================================================================
     MainWindow.xaml
     =========================================================================
     The LAYOUT of the main window. The behavior lives in MainWindow.xaml.cs.

     LAYOUT STRUCTURE (top to bottom):
       Row 0:  mode selector (Compress / Images → PDF / Merge toggle buttons)
       Row 1:  the drag & drop zone (shared by all three modes)
       Row 2:  action buttons (Add files / Add folder / Clear / Move up, down /
               Theme toggle - the Move buttons only show up in Merge mode)
       Row 3:  the file list (* = this row stretches to fill leftover space)
       Row 4:  controls (mode-specific: preset combo | page-size combo |
               Compress / Create PDF / Merge button + shared Save button)
       Row 5:  progress bar + status text

     Only ONE of each mode-specific control is visible at a time; the
     code-behind's ApplyModeUi() shows/hides them when the mode changes.

     THEMING RULES USED EVERYWHERE BELOW:
       - No hardcoded colors. Every brush comes from App.xaml via
         {DynamicResource Brush.Xxx}. The word "Dynamic" matters: it lets the
         theme toggle re-color the whole window instantly. (StaticResource would
         freeze the colors at load time - the bug we fixed.)

     XAML QUICK REFERENCE:
       - x:Name="Foo"  -> the control becomes a field "Foo" in the code-behind.
                          e.g. SaveButton.IsEnabled is set from C#.
       - Click="Bar"   -> wires a Button click to a method Bar in code-behind.
       - Checked="Baz" -> fires when a ToggleButton gets checked (mode switch).
       - {Binding Prop} -> binds a control property to a property of the data
                           item (see the ListBox ItemTemplate).
     ========================================================================= -->
<Window x:Class="PdfCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfCompressor"
        Height="600" Width="680"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource Brush.WindowBackground}">

    <Window.Resources>
        <!-- Segmented-look toggle used for the mode selector (Compress / Images → PDF / Merge).
             ToggleButton has no GroupName (that is a RadioButton concept), so the
             "only one checked at a time" radio behaviour is enforced manually in
             ModeButton_Checked in the code-behind. -->
        <Style x:Key="ModeButton" TargetType="ToggleButton">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.ButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.ButtonHover}"/>
                </Trigger>
                <!-- Checked = the active mode: paint it in the accent color. -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared dark-styled picker combo box (preset / page-size selectors).

             The ComboBox gets a CUSTOM template. Why? The default WPF ComboBox
             ignores our theme colors (it renders with hardcoded system colors).
             This template builds a ComboBox from scratch so everything matches
             the app theme. It is defined ONCE here as a reusable Style and
             applied with {StaticResource PickerComboBox} below - beats copying
             the ~70 lines of template into every combo box.

             Key details inside the template:
               - IsChecked is bound to IsDropDownOpen so clicking opens/closes
                 the dropdown.
               - Content="{TemplateBinding SelectionBoxItem}" makes the CLOSED
                 box display the currently selected entry. (A bare
                 ContentPresenter showed nothing - that was the "text doesn't
                 show" bug.)
               - TextElement.Foreground is the correct way to color text inside
                 a ContentPresenter (plain Foreground is not a valid
                 ContentPresenter property), so the text stays readable in dark
                 mode.
               - PART_Popup is the magic name WPF looks for to wire
                 IsDropDownOpen into the popup lifecycle. -->
        <Style x:Key="PickerComboBox" TargetType="ComboBox">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- Style for the items INSIDE the dropdown list -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                        <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Style.Triggers>
                            <!-- Highlighted = the row the mouse is hovering / keyboard selection is on -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.ButtonHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <!-- The custom visual tree of the closed combo box -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- The clickable "button" part (see comment on the style above). -->
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Renders the selected entry text in the
                                                     theme text color (TextElement.Foreground). -->
                                                <ContentPresenter
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <!-- The little down-arrow ▼ -->
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource Brush.TextSecondary}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ButtonHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ButtonPressed}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- The dropdown popup that appears below the box. -->
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder"
                                        Background="{DynamicResource Brush.SurfaceBackground}"
                                        BorderBrush="{DynamicResource Brush.ControlBorder}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <!-- ItemsPresenter renders the actual
                                             ComboBoxItem list. -->
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- While open, tint the box itself to "pressed" -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.ButtonPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin="16" gives the whole window a comfortable breathing space. -->
    <Grid Margin="16">
        <!-- The 6 rows of the layout (see header). Height="*" = take all the
             space the other rows did not consume. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Row 0: Mode selector =====================
             Three toggle buttons act like radio buttons: clicking one switches
             the whole window (file filter, option panel, action button). The
             first one starts checked (Compress = the original feature). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ToggleButton x:Name="CompressModeButton"
                          Style="{StaticResource ModeButton}"
                          Content="🗜 Compress PDFs"
                          IsChecked="True"
                          Checked="ModeButton_Checked"
                          Click="ModeButton_Click"/>
            <ToggleButton x:Name="ImagesModeButton"
                          Style="{StaticResource ModeButton}"
                          Content="🖼 Images → PDF"
                          Checked="ModeButton_Checked"
                          Click="ModeButton_Click"/>
            <ToggleButton x:Name="MergeModeButton"
                          Style="{StaticResource ModeButton}"
                          Content="📄 Merge PDFs"
                          Checked="ModeButton_Checked"
                          Click="ModeButton_Click"/>
        </StackPanel>

        <!-- ===================== Row 1: Drop zone =====================
             AllowDrop="True" is what makes this Border a drop target at all.
             The DragOver/Drop events (in code-behind) decide what happens.
             The texts are re-written by ApplyModeUi() when the mode changes,
             so DropText/DropHint are named for C#. -->
        <Border x:Name="DropZone"
                Grid.Row="1"
                Height="130" Margin="0,0,0,12"
                BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2" CornerRadius="10"
                Background="{DynamicResource Brush.DropZoneBackground}"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop"
                MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                Cursor="Hand">
            <!-- Centered "call to action" text inside the zone -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📄" FontSize="30" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropText"
                           Text="Drag &amp; drop PDF files here"
                           FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,6,0,0"/>
                <TextBlock x:Name="DropHint"
                           Text="or click the zone to browse · you can also add a whole folder below"
                           FontSize="11" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===================== Row 2: Action buttons ===================== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- AddFilesButton's label is swapped by ApplyModeUi()
                 ("Add PDF file(s)…" vs "Add image(s)…"). -->
            <Button x:Name="AddFilesButton" Content="Add PDF file(s)…" Padding="12,6" Click="AddFilesButton_Click"/>
            <Button x:Name="AddFolderButton" Content="Add folder…" Padding="12,6" Margin="8,0,0,0" Click="AddFolderButton_Click"/>
            <Button x:Name="ClearButton" Content="Clear list" Padding="12,6" Margin="8,0,0,0" Click="ClearButton_Click"/>
            <!-- Merge-only reordering: changes the document order the merger
                 will produce. Start collapsed; ApplyModeUi() shows them in
                 Merge mode. (UIA exposes the arrow character as a space, so
                 don't assert on the exact label text in automation tests.) -->
            <Button x:Name="MoveUpButton" Content="↑ Move up" Padding="12,6" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="MoveUpButton_Click"/>
            <Button x:Name="MoveDownButton" Content="↓ Move down" Padding="12,6" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="MoveDownButton_Click"/>
            <!-- The theme toggle. Click is wired ONLY here (Click="ThemeButton_Click") -
                 a past bug double-wired it and made every click toggle twice. -->
            <Button x:Name="ThemeButton" Content="☾ Dark" Padding="12,6" Margin="8,0,0,0" Click="ThemeButton_Click"/>
        </StackPanel>

        <!-- ===================== Row 3: File list ===================== -->
        <!-- ItemsSource is set in code-behind to the ObservableCollection of
             FileItem rows. The ItemTemplate describes how each row renders.
             The list ORDER matters: it is the page order in Images mode and
             the document order in Merge mode. -->
        <ListBox x:Name="FileList"
                 Grid.Row="3"
                 Margin="0,0,0,12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="{DynamicResource Brush.ListBackground}"
                 BorderBrush="{DynamicResource Brush.ControlBorder}" BorderThickness="1"
                 Foreground="{DynamicResource Brush.TextPrimary}">
            <ListBox.ItemTemplate>
                <!-- DataTemplate = "how to draw one FileItem". {Binding Name}
                     reads FileItem.Name, {Binding Size} reads FileItem.Size, etc.
                     StatusBrush is a Brush property on the item, so it can bind
                     straight to Foreground. -->
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="{Binding Size}" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}"/>
                        <TextBlock Text="{Binding Status}" Margin="14,0,0,0"
                                   Foreground="{Binding StatusBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===================== Row 4: Mode-specific controls + Save ===================== -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">

            <!-- Compress mode: preset picker (uses the shared PickerComboBox style) -->
            <StackPanel x:Name="PresetPanel" Orientation="Horizontal">
            <TextBlock Text="Preset:" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>

            <!-- SelectedIndex="1" means "Ebook (balanced)" is selected by default. -->
            <ComboBox x:Name="PresetBox" Style="{StaticResource PickerComboBox}" SelectedIndex="1">
                <ComboBoxItem Content="Screen (smallest file)"/>
                <ComboBoxItem Content="Ebook (balanced)"/>
                <ComboBoxItem Content="Printer (best quality)"/>
            </ComboBox>
            </StackPanel>

            <!-- Images → PDF mode: page sizing picker (same shared style).
                 Index 0 = fit A4, 1 = fit US Letter, 2 = one image pixel =
                 1/96 inch (so a 96 dpi scan comes out at its real size). -->
            <StackPanel x:Name="PageSizePanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="Pages:" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                <ComboBox x:Name="PageSizeBox" Style="{StaticResource PickerComboBox}" SelectedIndex="0">
                    <ComboBoxItem Content="Fit A4 (recommended)"/>
                    <ComboBoxItem Content="Fit US Letter"/>
                    <ComboBoxItem Content="Actual size (96 dpi)"/>
                </ComboBox>
            </StackPanel>

            <!-- Mode-specific action buttons: only one is visible at a time
                 (ApplyModeUi toggles Visibility). Compress starts enabled (its
                 handler guards against an empty list); all three start disabled
                 again while a job runs via SetBusy(true). -->
            <Button x:Name="CompressButton" Content="Compress" Padding="20,7" Margin="16,0,0,0"
                    FontWeight="Bold" Click="CompressButton_Click"/>
            <Button x:Name="CreatePdfButton" Content="Create PDF" Padding="20,7" Margin="16,0,0,0"
                    FontWeight="Bold" Visibility="Collapsed" Click="CreatePdfButton_Click"/>
            <Button x:Name="MergeButton" Content="Merge" Padding="20,7" Margin="16,0,0,0"
                    FontWeight="Bold" Visibility="Collapsed" Click="MergeButton_Click"/>
            <!-- Save starts DISABLED and only lights up after a successful run
                 (a compressed result, a converted PDF or a merged PDF). -->
            <Button x:Name="SaveButton" Content="Save…" Padding="20,7" Margin="10,0,0,0"
                    IsEnabled="False" FontWeight="Bold" Click="SaveButton_Click"/>
        </StackPanel>

        <!-- ===================== Row 5: Progress + status ===================== -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <!-- Foreground = the filled portion (accent blue), Background = the track -->
                <ProgressBar x:Name="Progress" Height="18" Margin="0,0,0,6"
                             Foreground="{DynamicResource Brush.Accent}"
                             Background="{DynamicResource Brush.ProgressBackground}"/>
                <!-- The one-line status message at the bottom -->
                <TextBlock x:Name="StatusText" Text="Drop PDFs or add files to begin."
                           Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
