<Application x:Class="PdfCompressor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ===== Dark palette ===== -->
        <SolidColorBrush x:Key="Brush.WindowBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Brush.SurfaceBackground" Color="#242428"/>
        <SolidColorBrush x:Key="Brush.ControlBackground" Color="#2B2B30"/>
        <SolidColorBrush x:Key="Brush.ControlBorder" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Brush.ListBackground" Color="#232327"/>
        <SolidColorBrush x:Key="Brush.ProgressBackground" Color="#33333A"/>
        <SolidColorBrush x:Key="Brush.DropZoneBackground" Color="#16212E"/>

        <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E8EAED"/>
        <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9AA0A6"/>
        <SolidColorBrush x:Key="Brush.TextDisabled" Color="#6B7280"/>

        <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>

        <SolidColorBrush x:Key="Brush.ButtonBackground" Color="#33333A"/>
        <SolidColorBrush x:Key="Brush.ButtonHover" Color="#3E3E46"/>
        <SolidColorBrush x:Key="Brush.ButtonPressed" Color="#2A2A30"/>
        <SolidColorBrush x:Key="Brush.ButtonDisabled" Color="#26262B"/>

        <!-- Status colors (readable on dark) -->
        <SolidColorBrush x:Key="Brush.StatusBlue" Color="#60A5FA"/>
        <SolidColorBrush x:Key="Brush.StatusGreen" Color="#4ADE80"/>
        <SolidColorBrush x:Key="Brush.StatusRed" Color="#F87171"/>
        <SolidColorBrush x:Key="Brush.StatusGray" Color="#9CA3AF"/>

        <!-- ===== Global button style ===== -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.ButtonBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ButtonHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ButtonPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.ButtonDisabled}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
