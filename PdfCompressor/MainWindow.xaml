<Window x:Class="PdfCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfCompressor"
        Height="600" Width="680"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource Brush.WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drop zone -->
        <Border x:Name="DropZone"
                Grid.Row="0"
                Height="130" Margin="0,0,0,12"
                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2" CornerRadius="10"
                Background="{StaticResource Brush.DropZoneBackground}"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop"
                MouseLeftButtonUp="DropZone_MouseLeftButtonUp"
                Cursor="Hand">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📄" FontSize="30" HorizontalAlignment="Center"/>
                <TextBlock x:Name="DropText"
                           Text="Drag &amp; drop PDF files here"
                           FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.TextPrimary}" Margin="0,6,0,0"/>
                <TextBlock Text="or click the zone to browse · you can also add a whole folder below"
                           FontSize="11" HorizontalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="AddFilesButton" Content="Add PDF file(s)…" Padding="12,6" Click="AddFilesButton_Click"/>
            <Button x:Name="AddFolderButton" Content="Add folder…" Padding="12,6" Margin="8,0,0,0" Click="AddFolderButton_Click"/>
            <Button x:Name="ClearButton" Content="Clear list" Padding="12,6" Margin="8,0,0,0" Click="ClearButton_Click"/>
        </StackPanel>

        <!-- File list -->
        <ListBox x:Name="FileList"
                 Grid.Row="2"
                 Margin="0,0,0,12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource Brush.ListBackground}"
                 BorderBrush="{StaticResource Brush.ControlBorder}" BorderThickness="1"
                 Foreground="{StaticResource Brush.TextPrimary}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"/>
                        <TextBlock Text="{Binding Size}" Margin="10,0,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBlock Text="{Binding Status}" Margin="14,0,0,0"
                                   Foreground="{Binding StatusBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Controls row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Preset:" VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <ComboBox x:Name="PresetBox" Width="160" Margin="8,0,0,0" SelectedIndex="1"
                      Background="{StaticResource Brush.ControlBackground}"
                      Foreground="{StaticResource Brush.TextPrimary}"
                      BorderBrush="{StaticResource Brush.ControlBorder}">
                <ComboBoxItem Content="Screen (smallest file)"/>
                <ComboBoxItem Content="Ebook (balanced)"/>
                <ComboBoxItem Content="Printer (best quality)"/>
            </ComboBox>
            <Button x:Name="CompressButton" Content="Compress" Padding="20,7" Margin="16,0,0,0"
                    FontWeight="Bold" Click="CompressButton_Click"/>
            <Button x:Name="SaveButton" Content="Save…" Padding="20,7" Margin="10,0,0,0"
                    IsEnabled="False" FontWeight="Bold" Click="SaveButton_Click"/>
        </StackPanel>

        <!-- Progress + status -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <ProgressBar x:Name="Progress" Height="18" Margin="0,0,0,6"
                             Foreground="{StaticResource Brush.Accent}"
                             Background="{StaticResource Brush.ProgressBackground}"/>
                <TextBlock x:Name="StatusText" Text="Drop PDFs or add files to begin."
                           Foreground="{StaticResource Brush.TextSecondary}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
