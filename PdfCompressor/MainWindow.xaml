<Window x:Class="PdfCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PdfCompressor"
        Height="660" Width="720"
        MinHeight="560" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Window.Resources>

        <!-- Segmented control: the mode picker (Compress / Images → PDF / Merge). -->
        <Style x:Key="SegmentButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SegmentSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="Auto"/>  <!-- mode picker -->
            <RowDefinition Height="Auto"/>  <!-- drop zone -->
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>     <!-- file list -->
            <RowDefinition Height="Auto"/>  <!-- options + actions -->
            <RowDefinition Height="Auto"/>  <!-- progress + status -->
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App mark (matches the application icon) -->
            <Border Width="26" Height="26" CornerRadius="6"
                    Background="{DynamicResource Brush.Accent}"
                    VerticalAlignment="Center">
                <Viewbox Margin="6">
                    <Path Stroke="{DynamicResource Brush.OnAccent}"
                          StrokeThickness="1.9"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 2.5,1.5 L 8,6 L 13.5,1.5 M 2.5,14.5 L 8,10 L 13.5,14.5"/>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PDF Compressor" FontSize="14.5" FontWeight="SemiBold"/>
                <TextBlock Text="Compress, merge and convert — all offline"
                           FontSize="11.5" Margin="0,1,0,0"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>

            <Button x:Name="ThemeButton"
                    Grid.Column="2"
                    Style="{StaticResource GhostButton}"
                    VerticalAlignment="Center"
                    ToolTip="Switch between light and dark theme"
                    Click="ThemeButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="ThemeGlyph"
                          VerticalAlignment="Center"
                          Fill="{x:Null}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 9.6,7 A 2.6,2.6 0 1 1 4.4,7 A 2.6,2.6 0 1 1 9.6,7 Z M 7,1.2 L 7,2.6 M 7,11.4 L 7,12.8 M 1.2,7 L 2.6,7 M 11.4,7 L 12.8,7 M 2.9,2.9 L 3.9,3.9 M 10.1,10.1 L 11.1,11.1 M 11.1,2.9 L 10.1,3.9 M 3.9,10.1 L 2.9,11.1"/>
                    <TextBlock x:Name="ThemeLabel" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============ Mode picker ============ -->
        <Border Grid.Row="1"
                HorizontalAlignment="Left"
                Margin="0,0,0,14"
                Padding="3"
                CornerRadius="6"
                Background="{DynamicResource Brush.SegmentBackground}">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="CompressModeButton"
                              Style="{StaticResource SegmentButton}"
                              IsChecked="True"
                              Checked="ModeButton_Checked"
                              Click="ModeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 2,1.8 L 8,6.4 L 14,1.8 M 2,14.2 L 8,9.6 L 14,14.2"/>
                        <TextBlock Text="Compress" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="ImagesModeButton"
                              Style="{StaticResource SegmentButton}"
                              Margin="4,0,0,0"
                              Checked="ModeButton_Checked"
                              Click="ModeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 2.5,2.5 L 13.5,2.5 L 13.5,13.5 L 2.5,13.5 Z M 2.5,10.8 L 6.2,7.2 L 8.6,9.6 L 10.6,7.6 L 13.5,10.5 M 10.4,5.3 A 1.1,1.1 0 1 1 12.6,5.3 A 1.1,1.1 0 1 1 10.4,5.3"/>
                        <TextBlock Text="Images → PDF" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="MergeModeButton"
                              Style="{StaticResource SegmentButton}"
                              Margin="4,0,0,0"
                              Checked="ModeButton_Checked"
                              Click="ModeButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path VerticalAlignment="Center"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 2.5,2.5 L 9.5,2.5 L 9.5,9.5 L 2.5,9.5 Z M 6.5,6.5 L 13.5,6.5 L 13.5,13.5 L 6.5,13.5 Z"/>
                        <TextBlock Text="Merge PDFs" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- ============ Drop zone ============ -->
        <Border x:Name="DropZone"
                Grid.Row="2"
                Height="128"
                CornerRadius="6"
                Background="{DynamicResource Brush.DropZoneBackground}"
                AllowDrop="True"
                Cursor="Hand"
                Focusable="False"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop"
                MouseLeftButtonUp="DropZone_MouseLeftButtonUp">
            <Grid>
                <Rectangle RadiusX="6" RadiusY="6"
                           Margin="1"
                           Stroke="{DynamicResource Brush.DropZoneBorder}"
                           StrokeThickness="1.5"
                           StrokeDashArray="4 3"
                           IsHitTestVisible="False"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Page with inward chevrons: "files go in" -->
                    <Grid Width="44" Height="44" HorizontalAlignment="Center">
                        <Rectangle Width="30" Height="38" RadiusX="4" RadiusY="4"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.8"/>
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{DynamicResource Brush.Accent}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 14,12.5 L 22,20 L 30,12.5 M 14,31.5 L 22,24 L 30,31.5"/>
                    </Grid>
                    <TextBlock x:Name="DropText"
                               Text="Drag &amp; drop PDF files here"
                               FontSize="15.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="DropHint"
                               Text="or click the zone to browse · you can also add a whole folder below"
                               FontSize="11.5" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Toolbar ============ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,6">
            <Button x:Name="AddFilesButton" Style="{StaticResource GhostButton}"
                    Content="Add PDF file(s)…" Click="AddFilesButton_Click"/>
            <Button x:Name="AddFolderButton" Style="{StaticResource GhostButton}"
                    Content="Add folder…" Margin="4,0,0,0" Click="AddFolderButton_Click"/>
            <Button x:Name="ClearButton" Style="{StaticResource GhostButton}"
                    Content="Clear list" Margin="4,0,0,0" Click="ClearButton_Click"/>
            <Button x:Name="MoveUpButton" Style="{StaticResource GhostButton}"
                    Content="↑ Move up" Margin="4,0,0,0" Visibility="Collapsed"
                    Click="MoveUpButton_Click"/>
            <Button x:Name="MoveDownButton" Style="{StaticResource GhostButton}"
                    Content="↓ Move down" Margin="4,0,0,0" Visibility="Collapsed"
                    Click="MoveDownButton_Click"/>
        </StackPanel>

        <!-- ============ File list ============ -->
        <Border Grid.Row="4"
                CornerRadius="6"
                Background="{DynamicResource Brush.ListBackground}"
                BorderBrush="{DynamicResource Brush.ControlBorder}"
                BorderThickness="1">
            <Grid>
                <ListBox x:Name="FileList" Padding="4" Margin="0,4,0,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Small page glyph -->
                                <Path Grid.Column="0"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource Brush.TextSecondary}"
                                      Opacity="0.85"
                                      Data="M 9.5,1 L 3.6,1 A 1.6,1.6 0 0 0 2,2.6 L 2,13.4 A 1.6,1.6 0 0 0 3.6,15 L 12.4,15 A 1.6,1.6 0 0 0 14,13.4 L 14,5.5 Z"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Path}"/>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Size}"
                                           Margin="12,0,0,0"
                                           MinWidth="58"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                             Fill="{Binding StatusBrush}"/>
                                    <TextBlock Text="{Binding Status}"
                                               Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{Binding StatusBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyHint"
                           Text="Nothing here yet — drop files above or use Add files."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="12.5"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
            </Grid>
        </Border>

        <!-- ============ Options + actions ============ -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Compress mode: preset picker -->
                <StackPanel x:Name="PresetPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Preset" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <ComboBox x:Name="PresetBox" Width="200" Margin="8,0,0,0" SelectedIndex="1">
                        <ComboBoxItem Content="Screen (smallest file)"/>
                        <ComboBoxItem Content="Ebook (balanced)"/>
                        <ComboBoxItem Content="Printer (best quality)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Images → PDF mode: page sizing picker -->
                <StackPanel x:Name="PageSizePanel" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="Page size" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <ComboBox x:Name="PageSizeBox" Width="200" Margin="8,0,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="Fit A4 (recommended)"/>
                        <ComboBoxItem Content="Fit US Letter"/>
                        <ComboBoxItem Content="Actual size (96 dpi)"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CompressButton" Style="{StaticResource PrimaryButton}"
                        Content="Compress" Click="CompressButton_Click"/>
                <Button x:Name="CreatePdfButton" Style="{StaticResource PrimaryButton}"
                        Content="Create PDF" Visibility="Collapsed" Click="CreatePdfButton_Click"/>
                <Button x:Name="MergeButton" Style="{StaticResource PrimaryButton}"
                        Content="Merge" Visibility="Collapsed" Click="MergeButton_Click"/>
                <Button x:Name="SaveButton" Content="Save…" Margin="8,0,0,0"
                        Padding="20,7" FontWeight="SemiBold" IsEnabled="False"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ============ Progress + status ============ -->
        <StackPanel Grid.Row="6" Margin="0,14,0,0">
            <ProgressBar x:Name="Progress" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText"
                       Text="Drop PDFs or add files to begin."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
        </StackPanel>
    </Grid>
</Window>
